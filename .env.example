# OpenAI-compatible API. Examples: OpenAI, OpenRouter, LM Studio, Ollama-compatible gateway.
AI_API_KEY=replace-me
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=replace-with-your-model
AI_TEMPERATURE=0

# MCP filesystem server root and local project workspace
PROJECT_ROOT=D:\project-data
WORKSPACE_DIR=workspace
MAX_SCRIPT_SECONDS=3600
MAX_REPAIR_ATTEMPTS=2

# Resource guardrails. Tune to your machine.
MAX_WORKER_MEMORY_GB=12
MAX_DATA_SAMPLE_ROWS=100
